{
  "manifest_version": 3,
  "name": "Last.fm Scrobbler for YouTube™",
  "version": "4.0.1",
  "description": "Scrobbling YouTube music videos to Last.fm with support for chapters/tracks, an Opera YouTube Music sidebar, and a Now Playing feed for companion extensions",
  "permissions": [
    "storage",
    "scripting",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://www.last.fm/api/*",
    "https://ws.audioscrobbler.com/2.0/*"
  ],
  "icons": {
    "16": "data/icons/16.png",
    "32": "data/icons/32.png",
    "48": "data/icons/48.png",
    "64": "data/icons/64.png",
    "128": "data/icons/128.png",
    "256": "data/icons/256.png",
    "512": "data/icons/512.png"
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "matches": [
        "*://*.youtube.com/*"
      ],
      "css": [
        "/data/core/inject.css"
      ],
      "js": [
        "/data/core/inject.js"
      ],
      "all_frames": true
    },
    {
      "run_at": "document_start",
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "/data/core/watch.js"
      ],
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "/data/core/index.html"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ],
  "homepage_url": "https://add0n.com/lastfm-tool.html?from=youtube",
  "options_ui": {
    "page": "data/options/index.html"
  },
  "sidebar_action": {
    "default_icon": {
      "16": "data/icons/16.png",
      "32": "data/icons/32.png",
      "64": "data/icons/64.png"
    },
    "default_title": "Last.fm Scrobbler — YouTube Music",
    "default_panel": "data/sidebar/index.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://music.youtube.com https://*.youtube.com;"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "youtube_sidebar",
        "enabled": true,
        "path": "data/sidebar/rules.json"
      }
    ]
  },
  "externally_connectable": {
    "ids": [
      "*"
    ]
  }
}
